# [default]
DEFAULT_PROVIDER="openai"                          # 默认 provider
DEFAULT_MODEL="qwen3-max"                          # 默认模型
DEFAULT_API_KEY="your-api-key"                     # 默认 API Key
DEFAULT_BASE_URL="http://{your_openai_ip}/v1"      # 默认 Base URL

# [llm]
LLM_MODEL_ID="qwen3-max"                           # 模型名称
LLM_API_KEY="sk-..."                               # API Key
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"  # Base URL

# [tool]
WEB_SEARCH_API_KEY="..."
WEB_SEARCH_MAX_CONTENT_LEN=1000

# [mcp]
MCP_NAME="mcp_server_1"                            # MCP 服务名
MCP_BASE_URL="http://{your_mcp_ip}/sse"            # MCP 地址
MCP_API_KEY="123456"                               # MCP 鉴权
MCP_ENABLED=true                                   # 是否启用 MCP

# [rag]
RAG_TOP_K=5                                        # 最终召回的top-k条数
RAG_FETCH_K=20                                     # 召回候选条数, 粗排池大小
RAG_ENABLE_MQE=true                                # 是否启用多查询扩展(MQE)
RAG_ENABLE_HYDE=false                              # 是否启用假设性文档嵌入(HyDE)
RAG_ENABLE_RERANK=false                            # 是否启用rerank
RAG_RERANK_MODE="light"                            # rerank 模式 light|llm

# embedding model
RAG_EMBEDDING_MODEL="text-embedding-3-large"       # 向量模型
RAG_EMBEDDING_BASE_URL="http://{your_embedding_ip}/v1"  # 向量服务地址
RAG_EMBEDDING_API_KEY="your-embed-key"             # 向量 API Key
RAG_EMBEDDING_DIM=1024                             # 向量维度

# rerank（可选，启用时需开启 RAG_ENABLE_RERANK=true 且 RAG_RERANK_MODE=llm）
RAG_RERANK_MODEL="rerank-model"                    # 精排模型
RAG_RERANK_BASE_URL="http://{your_rerank_ip}/v1"   # 精排服务地址
RAG_RERANK_API_KEY="your-rerank-key"               # 精排 API Key

# Qdrant 存储
RAG_QDRANT_URL="http://127.0.0.1:6333"             # Qdrant 服务地址
RAG_QDRANT_API_KEY=""                              # Qdrant API Key（如无鉴权可为空）
RAG_QDRANT_MIN_SCORE=0.5                           # 最小相似度过滤
